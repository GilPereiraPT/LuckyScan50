# Modelo sem credenciais. Guardar o ficheiro real FORA de public_html e do Git.
# O cron deve carregar o ficheiro com set -a; . /caminho/privado/gmail.env; set +a
LUCKYSCAN_EMAIL_ENABLED=0
LUCKYSCAN_GMAIL_USER=luckyscan50@gmail.com
LUCKYSCAN_GMAIL_APP_PASSWORD=
LUCKYSCAN_EMAIL_SIGNING_KEY=
LUCKYSCAN_EMAIL_DATABASE=/home/UTILIZADOR/private/luckyscan50/email.sqlite3
LUCKYSCAN_EMAIL_PUBLIC_URL=https://luckyscan50-api.policlinicosdesantoandre.com
LUCKYSCAN_EMAIL_DAILY_LIMIT=200
LUCKYSCAN_EMAIL_BATCH_LIMIT=20
# Datas-limite revistas: ficheiro JSON privado; vazio significa sem avisos de caducidade.
LUCKYSCAN_CLAIM_DEADLINES_FILE=/home/UTILIZADOR/private/luckyscan50/claim-deadlines.json
# Usar a MESMA origem de resultados do Passenger e do cron de recolha existente.
LUCKYSCAN_DATABASE=/home/UTILIZADOR/private/luckyscan50/results.sqlite3

# Opcional: caminho absoluto para os modelos personalizados
# LUCKYSCAN_EMAIL_TEMPLATES_FILE=/home/UTILIZADOR/luckyscan/email-templates.json
